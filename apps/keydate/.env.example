# Optional: Supabase social sign-in (Google / Facebook).
# Copy to .env.local for local dev, or set these as GitHub Actions *variables*
# for the deployed build. Both values are public and safe to expose client-side.
# Leave unset to run the app in guest mode (sign-in hidden).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
